{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-duplicate-imports": "error",
    "import/no-cycle": "error",
    "oxc/no-barrel-file": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],

    // tsconfig targets ES2022, which has no toSorted/toReversed; every sort here is on a fresh copy.
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // GraphQL's own field name.
    "no-underscore-dangle": ["error", { "allow": ["__typename"] }],
    // One screenful: a function that needs more is doing more than one thing.
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // node:test's test() returns a promise nobody awaits, and fakes are loosely typed.
      "files": ["**/*.test.ts", "src/panel.check.ts", "src/fixtures.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      // Vendored from Diff Breakdown: kept as upstream has it.
      "files": ["src/breakdown/**"],
      "rules": {
        "preserve-caught-error": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}
